# LiveKit server credentials. Create these in the LiveKit Cloud dashboard or
# use the values from your self-hosted LiveKit deployment.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Browser-facing LiveKit URL. Defaults to LIVEKIT_URL if omitted. Use this when
# the server SDK needs an internal address (e.g. Docker hostname) but browsers
# must connect to a different, host-routable address.
NEXT_PUBLIC_LIVEKIT_URL=

# Secret used to derive the default per-room E2EE passphrase. Generate with:
#   openssl rand -base64 32
E2EE_SECRET=

# OIDC provider configuration. The provider must expose a standard discovery
# document at ${OIDC_ISSUER}/.well-known/openid-configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# NextAuth secret used to encrypt session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: allow the settings menu in the video conference (LiveKit Cloud only).
# This also enables the recording tab.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true

# S3-compatible storage for egress recordings. Required if you use the recording feature.
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# Optional: enable Datadog browser logs.
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
# NEXT_PUBLIC_DATADOG_SITE=

# Postgres connection string for meeting metadata (required).
# Example: postgres://user:pass@localhost:5432/livekit_meet
DATABASE_URL=

# Base URL used for meeting links generated by the Bulwark plugin.
# Example: https://meet.sunbeam.pt
MEET_BASE_URL=

# Bulwark webhook endpoint for LiveKit lifecycle events (optional).
# BULWARK_WEBHOOK_URL=https://bulwark.example.com/webhooks/livekit
# BULWARK_WEBHOOK_SECRET=
